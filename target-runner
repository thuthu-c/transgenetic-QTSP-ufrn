#!/bin/bash

# Caminho para o seu executavel
EXE="./bin/exec"

# O irace passa os seguintes argumentos padrão inicialmente:
# 1: id da configuracao | 2: id da instancia | 3: seed | 4: caminho da instancia | 5: limite de tempo
CONFIG_ID=$1
INSTANCE_ID=$2
SEED=$3
INSTANCE=$4
shift 5 # Pula os 5 primeiros argumentos para ler as flags customizadas

# Valores padroes caso algo falhe
MAX_EVALS=50000
POP_SIZE=100
PROB_T=0.9
STEP_PROB=0.01
PLASMID_SIZE=0.2
PLASMID_BANK=10
PLASMID_MIN=0.1
PLASMID_MAX=0.4
# Faz o parse das flags definidas no parameters.txt
while [ "$1" != "" ]; do
    case $1 in
        --maxEvals ) shift; MAX_EVALS=$1 ;;
        --popSize ) shift; POP_SIZE=$1 ;;
        --probT ) shift; PROB_T=$1 ;;
        --stepProb ) shift; STEP_PROB=$1 ;;
        --plasmidSize ) shift; PLASMID_SIZE=$1 ;;
        --plasmidBank ) shift; PLASMID_BANK=$1 ;;
        --plasmidMin ) shift; PLASMID_MIN=$1 ;;
        --plasmidMax ) shift; PLASMID_MAX=$1 ;;
        

    esac
    shift
done

ALGORITHM="transV4"

# Executa o seu C++ na exata ordem que o argc/argv espera (9 argumentos no total)
# 1.maxEvals 2.popSize 3.probT 4.stepProb 5.plasmidSize 6.plasmidBank 7.plasmidMin 8. plasmidMax 9.instancia 10.algoritmo
$EXE $MAX_EVALS $POP_SIZE $PROB_T $STEP_PROB $PLASMID_SIZE $PLASMID_BANK $PLASMID_MIN $PLASMID_MAX $INSTANCE $ALGORITHM